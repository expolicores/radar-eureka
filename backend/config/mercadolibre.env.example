# Copy into backend/.env or export server-side. Never put these values in VITE_*.
# The spike needs a manually obtained access token; no automatic refresh/login.
MERCADOLIBRE_ACCESS_TOKEN=
# Reserved for the documented server-side OAuth flow; not used for token exchange here.
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REFRESH_TOKEN=
