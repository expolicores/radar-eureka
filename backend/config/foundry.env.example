# Optional CLI spike. Copy these entries into backend/.env or export them in PowerShell.
# Authentication is handled by DefaultAzureCredential / az login, never an API key.
AZURE_FOUNDRY_PROJECT_ENDPOINT=
EUREKA_FOUNDRY_AGENT_NAME=eureka-assistant
EUREKA_FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini-eureka
EUREKA_FOUNDRY_TIMEOUT_SECONDS=120
