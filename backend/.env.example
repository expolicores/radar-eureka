# Copiar como .env para desarrollo local. Los valores son de ejemplo, no reales.

# Obligatoria. Conexión a PostgreSQL 16 (la de docker-compose.yml en local).
DATABASE_URL=postgresql+psycopg://procurement:procurement_local@localhost:55432/public_procurement

# Exclusiva para pruebas destructivas; crear esta base aparte. Nunca apuntar a desarrollo.
TEST_DATABASE_URL=postgresql+psycopg://procurement:procurement_local@localhost:55432/public_procurement_test

# Almacenamiento local reservado para documentos futuros; no se crea al arrancar la beta.
# Las rutas relativas se resuelven desde backend/, independientemente del directorio de ejecución.
LOCAL_STORAGE_PATH=.local/documents
DOCUMENT_TIMEOUT_SECONDS=120
DOCUMENT_MAX_BYTES=52428800
EXTRACTION_TIMEOUT_SECONDS=60
EXTRACTION_MAX_BYTES=52428800
EXTRACTION_MAX_CHARS=2000000
EXTRACTION_MAX_FRAGMENTS=10000
EXTRACTION_MAX_PAGES=300

# Opcional. Ambiente: local, ci o production. Por defecto: local.
APP_ENV=local

# Opcional. Nivel de log: DEBUG, INFO, WARNING o ERROR. Por defecto: INFO.
LOG_LEVEL=INFO
EUREKA_RADAR_START_DATE=2026-10-15
EUREKA_RADAR_REGIONS=Boyacá,Casanare
EUREKA_RADAR_INTERVAL_HOURS=12
EUREKA_RADAR_MAX_PROCESSES=2500
EUREKA_PREFERRED_BUDGET_MAX=30000000
EUREKA_RADAR_CONFIG_PATH=config/eureka_radar.v1.json
EUREKA_METADATA_ALERT_EXCLUSIONS_PATH=config/eureka_metadata_alert_exclusions.v1.json

# OCR local como fallback; requiere extra Python ocr y binario Tesseract instalado explícitamente.
EXTRACTION_OCR_ENABLED=true
EXTRACTION_OCR_CONFIG_PATH=config/extraction_ocr.v1.json
EXTRACTION_TESSERACT_CMD=tesseract
# Opcional: directorio que contiene spa.traineddata; vacío usa descubrimiento del motor.
EXTRACTION_TESSDATA_PATH=

# Notificaciones manuales; deshabilitadas por defecto. File captura local, sin correo real.
EUREKA_NOTIFICATION_ENABLED=false
EUREKA_NOTIFICATION_MODE=disabled
# Lista separada por comas; sin destinatarios reales de ejemplo.
EUREKA_NOTIFICATION_RECIPIENTS=
EUREKA_NOTIFICATION_BASE_URL=http://127.0.0.1:5173
EUREKA_NOTIFICATION_CAPTURE_PATH=.local/notifications
EUREKA_NOTIFICATION_MAX_RETRIES=3
EUREKA_NOTIFICATION_RETRY_SECONDS=60
EUREKA_NOTIFICATION_TIMEOUT_SECONDS=15
EUREKA_NOTIFICATION_PROCESSING_LEASE_SECONDS=300
EUREKA_NOTIFICATION_IDEMPOTENCY_MARGIN_SECONDS=60
EUREKA_NOTIFICATION_MAX_MESSAGES=100
EUREKA_NOTIFICATION_DIGEST_MAX_ALERTS=100
# Solo para un envío real autorizado explícitamente; no necesarios para file/dry-run.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Local cycle: never registers a Windows task automatically.
EUREKA_AUTOMATION_ENABLED=false
EUREKA_AUTOMATION_ALLOW_REAL_SEND=false
EUREKA_AUTOMATION_INTERVAL_HOURS=12
EUREKA_AUTOMATION_TIMEZONE=America/Bogota
EUREKA_AUTOMATION_RUN_TIMES=07:00,19:00
EUREKA_AUTOMATION_LOG_PATH=.local/logs/eureka
EUREKA_LOG_RETENTION_DAYS=30
EUREKA_AUTOMATION_STALE_MINUTES=180
EUREKA_AUTOMATION_TASK_NAME=ComprasPublicas-EurekaRadar
