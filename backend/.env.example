# Copiar como .env para desarrollo local. Los valores son de ejemplo, no reales.

# Obligatoria. Conexión a PostgreSQL 16 (la de docker-compose.yml en local).
DATABASE_URL=postgresql+psycopg://procurement:procurement_local@localhost:5432/public_procurement

# Opcional. Ambiente: local, ci o production. Por defecto: local.
APP_ENV=local

# Opcional. Nivel de log: DEBUG, INFO, WARNING o ERROR. Por defecto: INFO.
LOG_LEVEL=INFO
